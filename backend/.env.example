APP_ENV=production
APP_BASE_URL=https://prozharka-tg.com/api
SITE_BASE_URL=https://prozharka-tg.com
APP_TIMEZONE=Europe/Moscow

# Telegram: create a fresh token before launch. Never commit the real value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=
TELEGRAM_BOT_USERNAME=

# Prodamus values from the payment-page account.
PRODAMUS_FORM_URL=
PRODAMUS_SECRET_KEY=
# Optional: when Prodamus recurring payments are enabled, set the subscription id.
# Without it, customers renew manually and every paid order extends access.
PRODAMUS_SUBSCRIPTION_ID=
# Set only to the integration code agreed with Prodamus support.
PRODAMUS_SYSTEM_CODE=
SUBSCRIPTION_PRICE=4990

# Access policy.
SUBSCRIPTION_DAYS=30
ACCESS_GRACE_HOURS=24
INVITE_LINK_TTL_HOURS=720

# Safety switches. Keep removals disabled until the end-to-end test passes.
DRY_RUN=1
ACCESS_REMOVAL_ENABLED=0

# Keep the database outside the public web directory.
DATABASE_PATH=

# Versions stored with every checkout consent record.
PRIVACY_VERSION=30.09.2026
PERSONAL_DATA_CONSENT_VERSION=30.09.2026
OFFER_VERSION=26.06.2026
